export component PetWindow inherits Window {
    in property <image> sheet;
    in property <int> frame-col;
    in property <int> frame-row;
    in property <float> pet-scale: 1.0;
    // Kept for compatibility with the native click callback.
    in property <bool> missing: false;
    in property <bool> liquid-orb: true;
    in property <image> orb-image;
    callback pet-clicked;
    callback drag-start;

    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: (liquid-orb ? 96px : 192px) * pet-scale;
    height: (liquid-orb ? 104px : 208px) * pet-scale;
    title: "PetPhrase";
    default-font-family: "Segoe UI";

    // Liquid glass orb; Rust resamples to this window's physical pixel size.
    orb := Rectangle {
        visible: root.liquid-orb;
        width: parent.width;
        height: parent.height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: transparent;
        opacity: ta.pressed ? 0.82 : ta.has-hover ? 0.94 : 1.0;
        animate opacity { duration: 160ms; easing: ease-out; }
        Image {
            width: parent.width;
            height: parent.height;
            source: root.orb-image;
            image-fit: fill;
            image-rendering: smooth;
        }
    }

    img := Image {
        visible: !root.liquid-orb;
        width: parent.width;
        height: parent.height;
        source: root.sheet;
        image-fit: fill;
        source-clip-x: root.frame-col * 192;
        source-clip-y: root.frame-row * 208;
        source-clip-width: 192;
        source-clip-height: 208;
    }

    // 拖拽后吞掉本次 click:系统拖窗接管后松手仍会触发 clicked
    property <bool> dragged: false;

    ta := TouchArea {
        width: root.liquid-orb ? 71px * root.pet-scale : parent.width;
        height: root.liquid-orb ? self.width : parent.height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        mouse-cursor: pointer;
        moved => {
            if (self.pressed && (Math.abs(self.mouse-x / 1px - self.pressed-x / 1px) > 4 || Math.abs(self.mouse-y / 1px - self.pressed-y / 1px) > 4)) {
                root.dragged = true;
                root.drag-start();
            }
        }
        clicked => {
            if (root.dragged) {
                root.dragged = false;
            } else {
                root.pet-clicked();
            }
        }
    }
}
